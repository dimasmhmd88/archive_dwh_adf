{
    "name": "PL_RET_03F_Table_FileCleanup",
    "properties": {
        "description": "FSD 4.18 / 5.4 / 6.1: remove exactly the archive files that this table log wrote, as listed by ret.usp_GetRunArchiveFiles (layout MD-07, no RunId in the file name), then record the result with ret.usp_LogCleanupResult (success: dates marked REMOVED; failure: orphan-file flag, ERR-EXP-03).",
        "activities": [
            {
                "name": "LKP_GetRunArchiveFiles",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.00:30:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderStoredProcedureName": "ret.usp_GetRunArchiveFiles",
                        "storedProcedureParameters": {
                            "TableLogId": {
                                "type": "Int64",
                                "value": {
                                    "value": "@pipeline().parameters.TableLogId",
                                    "type": "Expression"
                                }
                            }
                        },
                        "queryTimeout": "00:30:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_RET_SqlDb",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                },
                "description": "FSD 4.18: files this table log may have written (ExportStatus SUCCEEDED, FAILED or STOPPED)."
            },
            {
                "name": "FE_DeleteRunFiles",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "LKP_GetRunArchiveFiles",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "description": "One file per business date; a missing folder means the file was never written.",
                "typeProperties": {
                    "items": {
                        "value": "@activity('LKP_GetRunArchiveFiles').output.value",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "batchCount": 4,
                    "activities": [
                        {
                            "name": "GMD_RunFileFolderExists",
                            "type": "GetMetadata",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.00:30:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "dataset": {
                                    "referenceName": "DS_RET_ArchiveFolder",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "Container": {
                                            "value": "@pipeline().parameters.ArchiveContainer",
                                            "type": "Expression"
                                        },
                                        "FolderPath": {
                                            "value": "@item().FolderPath",
                                            "type": "Expression"
                                        }
                                    }
                                },
                                "fieldList": [
                                    "exists"
                                ],
                                "storeSettings": {
                                    "type": "AzureBlobStorageReadSettings",
                                    "recursive": false,
                                    "enablePartitionDiscovery": false
                                },
                                "formatSettings": {
                                    "type": "BinaryReadSettings"
                                }
                            }
                        },
                        {
                            "name": "IF_RunFileFolderExists",
                            "type": "IfCondition",
                            "dependsOn": [
                                {
                                    "activity": "GMD_RunFileFolderExists",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "expression": {
                                    "value": "@activity('GMD_RunFileFolderExists').output.exists",
                                    "type": "Expression"
                                },
                                "ifTrueActivities": [
                                    {
                                        "name": "DEL_RunFile",
                                        "type": "Delete",
                                        "dependsOn": [],
                                        "policy": {
                                            "timeout": "0.00:30:00",
                                            "retry": 2,
                                            "retryIntervalInSeconds": 60,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "description": "Deletes exactly one file of this run: <FolderPath>/<FileName> from ret.RetentionArchiveDate (no pattern; files of other runs are never touched).",
                                        "typeProperties": {
                                            "dataset": {
                                                "referenceName": "DS_RET_ArchiveFolder",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "Container": {
                                                        "value": "@pipeline().parameters.ArchiveContainer",
                                                        "type": "Expression"
                                                    },
                                                    "FolderPath": {
                                                        "value": "@item().FolderPath",
                                                        "type": "Expression"
                                                    }
                                                }
                                            },
                                            "enableLogging": false,
                                            "storeSettings": {
                                                "type": "AzureBlobStorageReadSettings",
                                                "recursive": false,
                                                "wildcardFileName": {
                                                    "value": "@item().FileName",
                                                    "type": "Expression"
                                                },
                                                "enablePartitionDiscovery": false
                                            }
                                        }
                                    }
                                ],
                                "ifFalseActivities": []
                            }
                        }
                    ]
                }
            },
            {
                "name": "LKP_LogCleanup_Succeeded",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "FE_DeleteRunFiles",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderStoredProcedureName": "ret.usp_LogCleanupResult",
                        "storedProcedureParameters": {
                            "TableLogId": {
                                "type": "Int64",
                                "value": {
                                    "value": "@pipeline().parameters.TableLogId",
                                    "type": "Expression"
                                }
                            },
                            "Status": {
                                "type": "String",
                                "value": "SUCCEEDED"
                            },
                            "FilesRemoved": {
                                "type": "Int32",
                                "value": {
                                    "value": "@length(activity('LKP_GetRunArchiveFiles').output.value)",
                                    "type": "Expression"
                                }
                            }
                        },
                        "queryTimeout": "00:30:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_RET_SqlDb",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "LKP_LogCleanup_DeleteFailed",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "FE_DeleteRunFiles",
                        "dependencyConditions": [
                            "Failed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderStoredProcedureName": "ret.usp_LogCleanupResult",
                        "storedProcedureParameters": {
                            "TableLogId": {
                                "type": "Int64",
                                "value": {
                                    "value": "@pipeline().parameters.TableLogId",
                                    "type": "Expression"
                                }
                            },
                            "Status": {
                                "type": "String",
                                "value": "FAILED"
                            },
                            "ErrorMessage": {
                                "type": "String",
                                "value": {
                                    "value": "@concat('One or more archive files of this run could not be deleted (', pipeline().parameters.BlobPath, '). ADF run ', pipeline().RunId)",
                                    "type": "Expression"
                                }
                            }
                        },
                        "queryTimeout": "00:30:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_RET_SqlDb",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "LKP_LogCleanup_ListFailed",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "LKP_GetRunArchiveFiles",
                        "dependencyConditions": [
                            "Failed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderStoredProcedureName": "ret.usp_LogCleanupResult",
                        "storedProcedureParameters": {
                            "TableLogId": {
                                "type": "Int64",
                                "value": {
                                    "value": "@pipeline().parameters.TableLogId",
                                    "type": "Expression"
                                }
                            },
                            "Status": {
                                "type": "String",
                                "value": "FAILED"
                            },
                            "ErrorMessage": {
                                "type": "String",
                                "value": {
                                    "value": "@activity('LKP_GetRunArchiveFiles').error.message",
                                    "type": "Expression"
                                }
                            }
                        },
                        "queryTimeout": "00:30:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_RET_SqlDb",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            }
        ],
        "parameters": {
            "TableLogId": {
                "type": "string"
            },
            "RunId": {
                "type": "string"
            },
            "ArchiveContainer": {
                "type": "string"
            },
            "BlobPath": {
                "type": "string"
            },
            "SchemaName": {
                "type": "string"
            },
            "TableName": {
                "type": "string"
            }
        },
        "variables": {},
        "folder": {
            "name": "DWH Retention/Internal"
        },
        "annotations": [
            "FSD-DWH-RET v1.1",
            "SQL v0.6",
            "DRAFT - not approved"
        ]
    }
}
