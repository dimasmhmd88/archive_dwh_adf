{
    "name": "PL_RET_04A_ArchiveExpiry_Level",
    "properties": {
        "description": "FSD 4.13 / 5.4 one level (YEAR or FILE): list the items, let ret.usp_GetExpiredArchiveFolders decide, delete the expired year folders of this table or the expired files, record the result (ERR-ARC-01 on failure; the next Daily Routine completes).",
        "activities": [
            {
                "name": "GMD_ListChildItems",
                "type": "GetMetadata",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.00:30:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "description": "YEAR: container root (year folders). FILE: folder <cut-off year>/<BlobPath>. 'exists' keeps a missing folder from failing the activity.",
                "typeProperties": {
                    "dataset": {
                        "referenceName": "DS_RET_ArchiveFolder",
                        "type": "DatasetReference",
                        "parameters": {
                            "Container": {
                                "value": "@pipeline().parameters.ArchiveContainer",
                                "type": "Expression"
                            },
                            "FolderPath": {
                                "value": "@pipeline().parameters.FolderPath",
                                "type": "Expression"
                            }
                        }
                    },
                    "fieldList": [
                        "exists",
                        "childItems"
                    ],
                    "storeSettings": {
                        "type": "AzureBlobStorageReadSettings",
                        "recursive": false,
                        "enablePartitionDiscovery": false
                    },
                    "formatSettings": {
                        "type": "BinaryReadSettings"
                    }
                }
            },
            {
                "name": "LKP_GetExpiredArchiveFolders",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "GMD_ListChildItems",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:30:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderStoredProcedureName": "ret.usp_GetExpiredArchiveFolders",
                        "storedProcedureParameters": {
                            "TableLogId": {
                                "type": "Int64",
                                "value": {
                                    "value": "@pipeline().parameters.TableLogId",
                                    "type": "Expression"
                                }
                            },
                            "ChildItemsJson": {
                                "type": "String",
                                "value": {
                                    "value": "@string(coalesce(activity('GMD_ListChildItems').output?.childItems, json('[]')))",
                                    "type": "Expression"
                                }
                            },
                            "Level": {
                                "type": "String",
                                "value": {
                                    "value": "@pipeline().parameters.Level",
                                    "type": "Expression"
                                }
                            },
                            "Year": {
                                "type": "Int16",
                                "value": {
                                    "value": "@pipeline().parameters.CutoffYear",
                                    "type": "Expression"
                                }
                            }
                        },
                        "queryTimeout": "00:30:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_RET_SqlDb",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                },
                "description": "Names and dates parsed in SQL; returns DELETE rows only (YEAR: <yyyy>/<BlobPath> before the cut-off year; FILE: files dated before the archive cut-off). Non-matching names are never deleted."
            },
            {
                "name": "FLT_ItemsToDelete",
                "type": "Filter",
                "dependsOn": [
                    {
                        "activity": "LKP_GetExpiredArchiveFolders",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('LKP_GetExpiredArchiveFolders').output.value",
                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@equals(item().Action, 'DELETE')",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "FE_DeleteExpiredItems",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "FLT_ItemsToDelete",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "description": "Parallel, batch 4 (FSD 6.1). The year folder is shared by all tables, so the table folder may not exist.",
                "typeProperties": {
                    "items": {
                        "value": "@activity('FLT_ItemsToDelete').output.value",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "batchCount": 4,
                    "activities": [
                        {
                            "name": "GMD_ItemFolderExists",
                            "type": "GetMetadata",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.00:30:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "dataset": {
                                    "referenceName": "DS_RET_ArchiveFolder",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "Container": {
                                            "value": "@pipeline().parameters.ArchiveContainer",
                                            "type": "Expression"
                                        },
                                        "FolderPath": {
                                            "value": "@item().FolderPath",
                                            "type": "Expression"
                                        }
                                    }
                                },
                                "fieldList": [
                                    "exists"
                                ],
                                "storeSettings": {
                                    "type": "AzureBlobStorageReadSettings",
                                    "recursive": false,
                                    "enablePartitionDiscovery": false
                                },
                                "formatSettings": {
                                    "type": "BinaryReadSettings"
                                }
                            }
                        },
                        {
                            "name": "IF_ItemFolderExists",
                            "type": "IfCondition",
                            "dependsOn": [
                                {
                                    "activity": "GMD_ItemFolderExists",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "userProperties": [],
                            "typeProperties": {
                                "expression": {
                                    "value": "@activity('GMD_ItemFolderExists').output.exists",
                                    "type": "Expression"
                                },
                                "ifTrueActivities": [
                                    {
                                        "name": "DEL_ExpiredItem",
                                        "type": "Delete",
                                        "dependsOn": [],
                                        "policy": {
                                            "timeout": "0.01:00:00",
                                            "retry": 2,
                                            "retryIntervalInSeconds": 60,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "description": "YEAR: whole folder <yyyy>/<BlobPath> (recursive). FILE: one file <BlobPath>_<yyyyMMdd>.parquet.",
                                        "typeProperties": {
                                            "dataset": {
                                                "referenceName": "DS_RET_ArchiveFolder",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "Container": {
                                                        "value": "@pipeline().parameters.ArchiveContainer",
                                                        "type": "Expression"
                                                    },
                                                    "FolderPath": {
                                                        "value": "@item().FolderPath",
                                                        "type": "Expression"
                                                    }
                                                }
                                            },
                                            "enableLogging": false,
                                            "storeSettings": {
                                                "type": "AzureBlobStorageReadSettings",
                                                "recursive": {
                                                    "value": "@equals(pipeline().parameters.Level, 'YEAR')",
                                                    "type": "Expression"
                                                },
                                                "wildcardFileName": {
                                                    "value": "@if(empty(item().FileName), '*', item().FileName)",
                                                    "type": "Expression"
                                                },
                                                "enablePartitionDiscovery": false
                                            }
                                        }
                                    }
                                ],
                                "ifFalseActivities": []
                            }
                        }
                    ]
                }
            },
            {
                "name": "LKP_LogExpired_Succeeded",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "FE_DeleteExpiredItems",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderStoredProcedureName": "ret.usp_LogExpiredArchiveResult",
                        "storedProcedureParameters": {
                            "TableLogId": {
                                "type": "Int64",
                                "value": {
                                    "value": "@pipeline().parameters.TableLogId",
                                    "type": "Expression"
                                }
                            },
                            "Status": {
                                "type": "String",
                                "value": "SUCCEEDED"
                            },
                            "FoldersDeleted": {
                                "type": "Int32",
                                "value": {
                                    "value": "@if(equals(pipeline().parameters.Level, 'YEAR'), activity('FLT_ItemsToDelete').output.FilteredItemsCount, 0)",
                                    "type": "Expression"
                                }
                            },
                            "FilesDeleted": {
                                "type": "Int32",
                                "value": {
                                    "value": "@if(equals(pipeline().parameters.Level, 'YEAR'), 0, activity('FLT_ItemsToDelete').output.FilteredItemsCount)",
                                    "type": "Expression"
                                }
                            }
                        },
                        "queryTimeout": "00:30:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_RET_SqlDb",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "LKP_LogExpired_DeleteFailed",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "FE_DeleteExpiredItems",
                        "dependencyConditions": [
                            "Failed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderStoredProcedureName": "ret.usp_LogExpiredArchiveResult",
                        "storedProcedureParameters": {
                            "TableLogId": {
                                "type": "Int64",
                                "value": {
                                    "value": "@pipeline().parameters.TableLogId",
                                    "type": "Expression"
                                }
                            },
                            "Status": {
                                "type": "String",
                                "value": "FAILED"
                            },
                            "ErrorMessage": {
                                "type": "String",
                                "value": {
                                    "value": "@concat('ERR-ARC-01: one or more expired items could not be deleted at level ', pipeline().parameters.Level, ' of ', if(empty(pipeline().parameters.FolderPath), '<container root>', pipeline().parameters.FolderPath), '. ADF run ', pipeline().RunId)",
                                    "type": "Expression"
                                }
                            }
                        },
                        "queryTimeout": "00:30:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_RET_SqlDb",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "LKP_LogExpired_ListFailed",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "GMD_ListChildItems",
                        "dependencyConditions": [
                            "Failed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderStoredProcedureName": "ret.usp_LogExpiredArchiveResult",
                        "storedProcedureParameters": {
                            "TableLogId": {
                                "type": "Int64",
                                "value": {
                                    "value": "@pipeline().parameters.TableLogId",
                                    "type": "Expression"
                                }
                            },
                            "Status": {
                                "type": "String",
                                "value": "FAILED"
                            },
                            "ErrorMessage": {
                                "type": "String",
                                "value": {
                                    "value": "@activity('GMD_ListChildItems').error.message",
                                    "type": "Expression"
                                }
                            }
                        },
                        "queryTimeout": "00:30:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_RET_SqlDb",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "LKP_LogExpired_ProcFailed",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "LKP_GetExpiredArchiveFolders",
                        "dependencyConditions": [
                            "Failed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderStoredProcedureName": "ret.usp_LogExpiredArchiveResult",
                        "storedProcedureParameters": {
                            "TableLogId": {
                                "type": "Int64",
                                "value": {
                                    "value": "@pipeline().parameters.TableLogId",
                                    "type": "Expression"
                                }
                            },
                            "Status": {
                                "type": "String",
                                "value": "FAILED"
                            },
                            "ErrorMessage": {
                                "type": "String",
                                "value": {
                                    "value": "@activity('LKP_GetExpiredArchiveFolders').error.message",
                                    "type": "Expression"
                                }
                            }
                        },
                        "queryTimeout": "00:30:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_RET_SqlDb",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                }
            }
        ],
        "parameters": {
            "TableLogId": {
                "type": "string"
            },
            "ArchiveContainer": {
                "type": "string"
            },
            "FolderPath": {
                "type": "string",
                "defaultValue": ""
            },
            "Level": {
                "type": "string"
            },
            "CutoffYear": {
                "type": "int"
            }
        },
        "variables": {},
        "folder": {
            "name": "DWH Retention/Internal"
        },
        "annotations": [
            "FSD-DWH-RET v1.1",
            "SQL v0.6",
            "DRAFT - not approved"
        ]
    }
}
