{
    "name": "PL_RETB_02_DailyRoutine_Master",
    "properties": {
        "description": "PL-02 / PRC-03 / FR-012: Daily Routine, scheduled every day 21:00 UTC+7 (BR-18). Selects active tables whose Initial Cut-off Run completed before the run date, from DailyRoutineStartDate (FR-020). RunDate empty = today UTC+7; manual rerun may pass an earlier date (DBR-15). Concurrency 1.",
        "activities": [
            {
                "name": "LKP_StartRunAndGetTables",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.00:30:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderQuery": {
                            "value": "@concat('EXEC ret.usp_StartRunAndGetTables @ProcessType = ''', 'DAILY_ROUTINE', ''', @TriggerType = ''', if(equals(pipeline().TriggerType, 'ScheduleTrigger'), 'SCHEDULE', 'MANUAL'), ''', @AdfPipelineRunId = ''', pipeline().RunId, ''', @RunDate = ', if(empty(trim(coalesce(pipeline().parameters.RunDate, ''))), 'NULL', concat('''', formatDateTime(if(empty(trim(coalesce(pipeline().parameters.RunDate, ''))), '1900-01-01', trim(coalesce(pipeline().parameters.RunDate, ''))), 'yyyy-MM-dd'), '''')), ', @TriggeredBy = ', concat('N''', replace(if(empty(trim(coalesce(pipeline().parameters.TriggeredBy, ''))), concat(pipeline().TriggerType, ': ', pipeline().TriggerName), trim(coalesce(pipeline().parameters.TriggeredBy, ''))), '''', ''''''), ''''), ', @DowntimeReference = ', 'NULL', ', @TableConfigIdList = ', 'NULL', ';')",
                            "type": "Expression"
                        },
                        "queryTimeout": "00:30:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_RET_SqlDb",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                },
                "description": "Option B, one Lookup: usp_StartRun (run record, run date UTC+7, idempotent per ADF run ID) + usp_GetTablesToProcess (FR-004). One row per table; one row with TableConfigId NULL when none. A selection error closes the run (FAILED) in SQL and fails this activity."
            },
            {
                "name": "SET_RunId",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "LKP_StartRunAndGetTables",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "variableName": "vRunId",
                    "value": {
                        "value": "@string(activity('LKP_StartRunAndGetTables').output.value[0].RunId)",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "SET_ProcessType",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "SET_RunId",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "variableName": "vProcessType",
                    "value": {
                        "value": "@activity('LKP_StartRunAndGetTables').output.value[0].ProcessType",
                        "type": "Expression"
                    }
                },
                "description": "Process type as recorded by usp_StartRun (VALIDATION when ValidateOnly = true)."
            },
            {
                "name": "FLT_Tables",
                "type": "Filter",
                "dependsOn": [
                    {
                        "activity": "SET_ProcessType",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('LKP_StartRunAndGetTables').output.value",
                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@greater(coalesce(item().TableConfigId, 0), 0)",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "FE_Tables",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "FLT_Tables",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "description": "Sequential (DEC-07). A failed table never blocks the next one.",
                "typeProperties": {
                    "items": {
                        "value": "@activity('FLT_Tables').output.value",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "EXEC_TableProcess",
                            "type": "ExecutePipeline",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "PL_RETB_03_Table_Process",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                    "RunId": {
                                        "value": "@variables('vRunId')",
                                        "type": "Expression"
                                    },
                                    "TableConfigId": {
                                        "value": "@string(item().TableConfigId)",
                                        "type": "Expression"
                                    },
                                    "ProcessType": {
                                        "value": "@variables('vProcessType')",
                                        "type": "Expression"
                                    },
                                    "InitialCutoffMethod": {
                                        "value": "@item().InitialCutoffMethod",
                                        "type": "Expression"
                                    },
                                    "ArchiveContainer": {
                                        "value": "@item().ArchiveContainer",
                                        "type": "Expression"
                                    },
                                    "BlobPath": {
                                        "value": "@item().BlobPath",
                                        "type": "Expression"
                                    },
                                    "SchemaName": {
                                        "value": "@item().SchemaName",
                                        "type": "Expression"
                                    },
                                    "TableName": {
                                        "value": "@item().TableName",
                                        "type": "Expression"
                                    }
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "LKP_EndRun",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "FE_Tables",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:30:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "SqlServerSource",
                        "sqlReaderStoredProcedureName": "ret.usp_EndRun",
                        "storedProcedureParameters": {
                            "RunId": {
                                "type": "Int64",
                                "value": {
                                    "value": "@variables('vRunId')",
                                    "type": "Expression"
                                }
                            },
                            "FailPipelineOnError": {
                                "type": "Boolean",
                                "value": true
                            }
                        },
                        "queryTimeout": "00:30:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_RET_SqlDb",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": true
                },
                "description": "FR-014: closes the run; raises an error (pipeline FAILED) when the run is not SUCCEEDED [REC 8.3]."
            }
        ],
        "parameters": {
            "RunDate": {
                "type": "string",
                "defaultValue": ""
            },
            "TriggeredBy": {
                "type": "string",
                "defaultValue": ""
            }
        },
        "variables": {
            "vRunId": {
                "type": "String",
                "defaultValue": ""
            },
            "vProcessType": {
                "type": "String",
                "defaultValue": ""
            }
        },
        "folder": {
            "name": "DWH Retention Opsi B"
        },
        "annotations": [
            "FSD-DWH-RET v1.1",
            "SQL v0.7-opsiB",
            "ADF opsi B v0.1",
            "DRAFT - not approved"
        ],
        "concurrency": 1
    }
}
