{
    "name": "PL_RET_04_ArchiveExpiry",
    "properties": {
        "description": "FSD 4.13 / 5.4 / DR-05: delete archive data with business date before the archive cut-off, layout MD-07 <container>/<yyyy>/<BlobPath>/<BlobPath>_<yyyyMMdd>.parquet: level YEAR on the container root, then level FILE in the cut-off year. A missing folder is a no-op.",
        "activities": [
            {
                "name": "EXEC_Level_Year",
                "type": "ExecutePipeline",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "PL_RET_04A_ArchiveExpiry_Level",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "TableLogId": {
                            "value": "@pipeline().parameters.TableLogId",
                            "type": "Expression"
                        },
                        "ArchiveContainer": {
                            "value": "@pipeline().parameters.ArchiveContainer",
                            "type": "Expression"
                        },
                        "FolderPath": "",
                        "Level": "YEAR",
                        "CutoffYear": {
                            "value": "@int(substring(pipeline().parameters.ArchiveCutoffDate, 0, 4))",
                            "type": "Expression"
                        }
                    }
                },
                "description": "Container root: folders <yyyy>/<BlobPath> of years before the archive cut-off year are deleted whole."
            },
            {
                "name": "EXEC_Level_File",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "EXEC_Level_Year",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "PL_RET_04A_ArchiveExpiry_Level",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "TableLogId": {
                            "value": "@pipeline().parameters.TableLogId",
                            "type": "Expression"
                        },
                        "ArchiveContainer": {
                            "value": "@pipeline().parameters.ArchiveContainer",
                            "type": "Expression"
                        },
                        "FolderPath": {
                            "value": "@concat(substring(pipeline().parameters.ArchiveCutoffDate, 0, 4), '/', pipeline().parameters.BlobPath)",
                            "type": "Expression"
                        },
                        "Level": "FILE",
                        "CutoffYear": {
                            "value": "@int(substring(pipeline().parameters.ArchiveCutoffDate, 0, 4))",
                            "type": "Expression"
                        }
                    }
                },
                "description": "Folder <archive cut-off year>/<BlobPath>: files dated before the archive cut-off are deleted."
            }
        ],
        "parameters": {
            "TableLogId": {
                "type": "string"
            },
            "ArchiveContainer": {
                "type": "string"
            },
            "BlobPath": {
                "type": "string"
            },
            "ArchiveCutoffDate": {
                "type": "string"
            }
        },
        "variables": {},
        "folder": {
            "name": "DWH Retention/Internal"
        },
        "annotations": [
            "FSD-DWH-RET v1.1",
            "SQL v0.6",
            "DRAFT - not approved"
        ]
    }
}
