{
    "name": "PL_RET_04_ArchiveExpiry",
    "properties": {
        "description": "PL-04 / PRC-04 / FR-013 (DR-05, BR-14): delete archive folders with business date before the archive cut-off date, traversing year=YYYY -> month=MM -> day=DD (MD-07, Figure 7). Folder paths of the cut-off year and month are derived from ArchiveCutoffDate; a missing folder is a no-op.",
        "activities": [
            {
                "name": "EXEC_Level_Year",
                "type": "ExecutePipeline",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "PL_RET_04A_ArchiveExpiry_Level",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "TableLogId": {
                            "value": "@pipeline().parameters.TableLogId",
                            "type": "Expression"
                        },
                        "ArchiveContainer": {
                            "value": "@pipeline().parameters.ArchiveContainer",
                            "type": "Expression"
                        },
                        "FolderPath": {
                            "value": "@pipeline().parameters.BlobPath",
                            "type": "Expression"
                        },
                        "Level": "YEAR",
                        "CutoffYear": {
                            "value": "@int(substring(pipeline().parameters.ArchiveCutoffDate, 0, 4))",
                            "type": "Expression"
                        },
                        "CutoffMonth": {
                            "value": "@int(substring(pipeline().parameters.ArchiveCutoffDate, 5, 2))",
                            "type": "Expression"
                        }
                    }
                },
                "description": "Year folders before the cut-off year are deleted whole."
            },
            {
                "name": "EXEC_Level_Month",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "EXEC_Level_Year",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "PL_RET_04A_ArchiveExpiry_Level",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "TableLogId": {
                            "value": "@pipeline().parameters.TableLogId",
                            "type": "Expression"
                        },
                        "ArchiveContainer": {
                            "value": "@pipeline().parameters.ArchiveContainer",
                            "type": "Expression"
                        },
                        "FolderPath": {
                            "value": "@concat(pipeline().parameters.BlobPath, '/year=', substring(pipeline().parameters.ArchiveCutoffDate, 0, 4))",
                            "type": "Expression"
                        },
                        "Level": "MONTH",
                        "CutoffYear": {
                            "value": "@int(substring(pipeline().parameters.ArchiveCutoffDate, 0, 4))",
                            "type": "Expression"
                        },
                        "CutoffMonth": {
                            "value": "@int(substring(pipeline().parameters.ArchiveCutoffDate, 5, 2))",
                            "type": "Expression"
                        }
                    }
                },
                "description": "Inside the cut-off year: month folders before the cut-off month."
            },
            {
                "name": "EXEC_Level_Day",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "EXEC_Level_Month",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "PL_RET_04A_ArchiveExpiry_Level",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "TableLogId": {
                            "value": "@pipeline().parameters.TableLogId",
                            "type": "Expression"
                        },
                        "ArchiveContainer": {
                            "value": "@pipeline().parameters.ArchiveContainer",
                            "type": "Expression"
                        },
                        "FolderPath": {
                            "value": "@concat(pipeline().parameters.BlobPath, '/year=', substring(pipeline().parameters.ArchiveCutoffDate, 0, 4), '/month=', substring(pipeline().parameters.ArchiveCutoffDate, 5, 2))",
                            "type": "Expression"
                        },
                        "Level": "DAY",
                        "CutoffYear": {
                            "value": "@int(substring(pipeline().parameters.ArchiveCutoffDate, 0, 4))",
                            "type": "Expression"
                        },
                        "CutoffMonth": {
                            "value": "@int(substring(pipeline().parameters.ArchiveCutoffDate, 5, 2))",
                            "type": "Expression"
                        }
                    }
                },
                "description": "Inside the cut-off month: day folders before the cut-off day."
            }
        ],
        "parameters": {
            "TableLogId": {
                "type": "string"
            },
            "ArchiveContainer": {
                "type": "string"
            },
            "BlobPath": {
                "type": "string"
            },
            "ArchiveCutoffDate": {
                "type": "string"
            }
        },
        "variables": {},
        "folder": {
            "name": "DWH Retention/Internal"
        },
        "annotations": [
            "FSD-DWH-RET-001 v0.2",
            "DRAFT - not approved"
        ]
    }
}
